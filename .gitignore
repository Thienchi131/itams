# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# backup database (Cài đặt > Backup & Restore + cron scripts/backup-db.sh) —
# file dump DB thật (dù đã mã hoá AES-256-GCM), không được để lọt vào git.
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# file hệ thống/home Linux lẫn trong thư mục trên VPS
.bash*
.profile
.sudo_as_admin_successful
.cache/
.config/
.ssh/
.docker/
_to_delete/
